<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Curio" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/forest_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:colorBackground">@color/cream_white</item>
        <item name="colorSurface">@color/cream_white</item>
        <item name="colorSurfaceVariant">@color/white</item>
        <item name="colorSecondaryContainer">@color/baby_blue</item>
        <item name="colorOnSecondaryContainer">@color/deep_grey</item>
        <item name="colorTertiaryContainer">@color/baby_blue</item>
        <item name="colorOnTertiaryContainer">@color/deep_grey</item>
        <item name="android:textColorPrimary">@color/deep_grey</item>
        <item name="android:statusBarColor">@color/forest_green</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
        <item name="fontFamily">@font/nunito</item>
        <item name="android:fontFamily">@font/nunito</item>
    </style>

    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.MediumComponent</item>
        <item name="colorSurface">@color/white</item>
    </style>

    <style name="ShapeAppearance.App.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">28dp</item>
    </style>
</resources>