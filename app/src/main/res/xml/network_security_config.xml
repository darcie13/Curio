<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows both HTTPS and HTTP traffic so the WebView can load any URL,
  and also permits Jsoup to scrape HTTP pages for metadata.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>